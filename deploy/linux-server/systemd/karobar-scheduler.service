[Unit]
Description=Karobar-App ERP Laravel Scheduler Daemon
After=network.target mariadb.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/karobar-server
ExecStart=/usr/bin/php /opt/karobar-server/artisan schedule:work
Restart=always
RestartSec=5
StandardOutput=append:/opt/karobar-server/storage/logs/scheduler.log
StandardError=append:/opt/karobar-server/storage/logs/scheduler.log

[Install]
WantedBy=multi-user.target
