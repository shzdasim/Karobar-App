<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Karobar.Host</RootNamespace>
    <AssemblyName>Karobar-Native</AssemblyName>
    <ApplicationIcon>..\..\..\desktop\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or $([MSBuild]::IsOSPlatform('Windows')) or '$(VerifyWindowsDesktopCompile)' == 'true'">
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);WINDOWS_DESKTOP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karobar.Core\Karobar.Core.csproj" />
    <ProjectReference Include="..\Karobar.Data\Karobar.Data.csproj" />
    <ProjectReference Include="..\Karobar.Services\Karobar.Services.csproj" />
    <ProjectReference Include="..\Karobar.Printing\Karobar.Printing.csproj" />
    <ProjectReference Include="..\Karobar.Background\Karobar.Background.csproj" />
    <ProjectReference Include="..\Karobar.Api\Karobar.Api.csproj" />
  </ItemGroup>
</Project>
